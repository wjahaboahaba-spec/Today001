-- >>> แทนที่ฟังก์ชัน shootHead เดิมด้วยเวอร์ชันนี้
local function shootHead(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local head = targetPlayer.Character:FindFirstChild("Head")
    local hum  = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not head or not hum or hum.Health <= 0 then return false end

    local tool, remote = getWeaponAndRemote()
    -- (getWeaponAndRemote อาจคืน (tool, remote) หรือ nils)
    if not remote then return false end

    -- สร้าง ESP ทันทีเมื่อยิง
    local gui = createHeadESP(targetPlayer)
    -- เก็บข้อมูลเริ่มต้น
    local initialHealth = hum.Health

    -- ถ้ายังไม่มี entry ให้สร้าง
    if not shotESP[targetPlayer] then
        shotESP[targetPlayer] = { gui = gui, conn = nil, removeTimer = nil, lastHealth = initialHealth }
    else
        shotESP[targetPlayer].gui = gui
        shotESP[targetPlayer].lastHealth = initialHealth
    end

    -- ส่งคำสั่งยิง
    local ok, err = pcall(function()
        -- บาง remote ต้องการตำแหน่ง; บางอันอาจต้องการรูปแบบอื่น แต่เดิมโค้ดส่ง head.Position
        remote:FireServer(head.Position)
    end)
    if not ok then
        warn("[Aimbot] FireServer failed:", err)
        -- ลบ ESP ถ้า remote ล้มเหลว
        removeESPForPlayer(targetPlayer)
        return false
    end

    -- เชื่อมต่อเพื่อตรวจ Health Changed (ถ้ายังไม่มี)
    if shotESP[targetPlayer] and not shotESP[targetPlayer].conn then
        local conn
        conn = hum:GetPropertyChangedSignal("Health"):Connect(function()
            local newH = hum.Health
            local info = shotESP[targetPlayer]
            if not info then
                if conn then pcall(function() conn:Disconnect() end) end
                return
            end

            -- ถ้าเลือดลดจากค่า lastHealth => ถือว่าโดนจริง
            if newH < (info.lastHealth or initialHealth) then
                info.lastHealth = newH
                -- ให้ ESP คงอยู่อีกสักพัก ถ้าไม่มีโดนซ้ำจะหายเองภายหลัง
                scheduleRemoveAfter(targetPlayer, 5) -- เก็บไว้ 5 วินาทีหลังการโดนครั้งสุดท้าย
            else
                -- ถ้า health เพิ่มขึ้น (heal) ให้อัพ lastHealth ด้วย
                info.lastHealth = newH
            end

            -- ถ้าตาย ให้ลบ ESP ทันที
            if newH <= 0 then
                removeESPForPlayer(targetPlayer)
                if conn then pcall(function() conn:Disconnect() end) end
            end
        end)
        shotESP[targetPlayer].conn = conn
    end

    -- ถ้าไม่มีการลดเลือดภายในช่วงสั้น ๆ (แปลว่า remote อาจไม่ทำดาเมจจริง) -> ลบ ESP
    -- หน่วงสั้น ๆ เพื่อตรวจว่า health ลดจริงหรือไม่
    task.delay(0.7, function()
        -- ถา้ entry ถูกลบไปแล้ว ก็จบ
        local info = shotESP[targetPlayer]
        if not info then return end
        local humNow = targetPlayer.Character and targetPlayer.Character:FindFirstChildOfClass("Humanoid")
        local nowHealth = humNow and humNow.Health or nil
        if nowHealth == nil then
            removeESPForPlayer(targetPlayer)
            return
        end
        -- ถ้ายังเท่ากับ initialHealth (ไม่มีดาเมจ) -> ลบ
        if nowHealth >= (initialHealth or 0) then
            -- ไม่มีการลดเลือดภายใน 0.7 วินาที -> เอา ESP ออก
            removeESPForPlayer(targetPlayer)
        else
            -- มีการลด -> schedule ให้ลบหลัง 5 วินาทีถ้าไม่มีโดนซ้ำ
            scheduleRemoveAfter(targetPlayer, 5)
        end
    end)

    return true
end



