local function scheduleRemoveAfter(plr, seconds)
    if not plr then return end
    if not shotESP[plr] then return end
    if shotESP[plr].removeTimer then
        pcall(task.cancel, shotESP[plr].removeTimer)
        shotESP[plr].removeTimer = nil
    end
    local t = task.defer(function()
        task.wait(seconds)
        removeESPForPlayer(plr)
    end)
    shotESP[plr].removeTimer = t
end

