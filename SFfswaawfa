-- ✅ ล็อกตัวในกล่อง (แบบยึดแน่น ไม่ขยับ)
local function lockPlayerInBox(position)
    if fishingCage then
        fishingCage:Destroy()
    end

    local part = Instance.new("Part")
    part.Size = Vector3.new(4, 6, 4)
    part.Anchored = true
    part.Position = position
    part.CanCollide = true
    part.Transparency = 1
    part.Name = "FishingCage"
    part.Parent = workspace

    fishingCage = part

    tpTo(position + Vector3.new(0, 3, 0))

    local char = player.Character or player.CharacterAdded:Wait()
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if humanoid and hrp then
        humanoid.PlatformStand = false
        humanoid.Sit = true
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

        local existingWeld = hrp:FindFirstChild("LockWeld")
        if existingWeld then existingWeld:Destroy() end

        local weld = Instance.new("WeldConstraint")
        weld.Name = "LockWeld"
        weld.Part0 = hrp
        weld.Part1 = part
        weld.Parent = hrp
    end

    print("📦 ตัวถูกล็อกในกล่องแบบยึดแน่น")
end

